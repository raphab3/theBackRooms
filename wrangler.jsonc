{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backrooms",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Publicado em backrooms.buracoonline.com (a raiz do domínio é outro site, na Vercel).
  "routes": [{ "pattern": "backrooms.buracoonline.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "apps/game/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    // Cloudflare Access: team domain (ex.: seutime.cloudflareaccess.com) e AUD da aplicação que protege /admin/* e /api/admin/*.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "backrooms",
      "database_id": "bbea1666-34ad-4696-86c8-ea29fdfd9c80",
      "migrations_dir": "drizzle",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDO" },
      { "name": "LOBBIES", "class_name": "LobbyDO" },
      { "name": "LOBBY_DIRECTORY", "class_name": "LobbyDirectoryDO" },
      { "name": "WORLDS", "class_name": "WorldDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] },
    { "tag": "v2", "new_sqlite_classes": ["LobbyDO", "LobbyDirectoryDO"] },
    { "tag": "v3", "new_sqlite_classes": ["WorldDO"] },
  ],
  // Telemetria (worker/telemetry.js) desligada até ativar o Analytics Engine no painel da conta;
  // sem o binding ela não faz nada. Para ligar, descomente:
  // "analytics_engine_datasets": [{ "binding": "TELEMETRY", "dataset": "backrooms_telemetry" }],
}
