{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backrooms",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    // Cloudflare Access: team domain (ex.: seutime.cloudflareaccess.com) e AUD da aplicação que protege /admin/* e /api/admin/*.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "backrooms",
      // Troque pelo id exibido em `pnpm exec wrangler d1 create backrooms` antes do primeiro deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle",
    },
  ],
}
