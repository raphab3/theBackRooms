{
  "name": "backrooms-local",
  "version": "60.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/local-server.mjs",
    "dev": "wrangler dev",
    "release": "wrangler d1 migrations apply backrooms --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply backrooms --local",
    "test": "node tests/multiplayer.mjs && node tests/telemetry.mjs",
    "load": "node tests/load.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "prettier --check . && eslint . && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "wrangler": "^4.149.0"
  }
}
