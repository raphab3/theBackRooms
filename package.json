{
  "name": "backrooms-local",
  "version": "60.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "pnpm build && node scripts/local-server.mjs",
    "dev": "node scripts/copy-admin.mjs && concurrently -k -n game,worker \"pnpm --filter @backrooms/game dev\" \"wrangler dev\"",
    "build": "node scripts/copy-admin.mjs && pnpm --filter @backrooms/game build",
    "release": "pnpm build && wrangler d1 migrations apply backrooms --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply backrooms --local",
    "test": "node tests/netsync.mjs && node tests/multiplayer.mjs && node tests/telemetry.mjs && node --test 'packages/shared/*.test.ts' && vitest run",
    "load": "node tests/load.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "prettier --check . && eslint . && pnpm test"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "wrangler": "^4.149.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@backrooms/shared": "workspace:*"
  }
}
